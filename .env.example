# Copy to .env and adjust.  .env is git-ignored: NEVER commit real credentials.
# Shell environment variables override values in this file.

# ---------------------------------------------------------------- target ----
# Which target/scenario: retail-mock (default, local mock) | quickpizza | freshdesk
# TARGET_PROFILE=retail-mock
# Leave TARGET_BASE_URL unset to use the profile default (retail-mock ->
# http://localhost:8080). Set it ONLY to an environment you are explicitly
# authorized to load test. Any non-localhost target is refused by the load and
# stress tests unless CONFIRM_AUTHORIZED_TARGET=true.
# TARGET_BASE_URL=https://staging.example.test
# CONFIRM_AUTHORIZED_TARGET=false

# ------------------------------------------------------------------ auth ----
# AUTH_TYPE: none | bearer | apikey | token. Leave empty = auto (bearer if API_TOKEN is set, else none)
AUTH_TYPE=
API_TOKEN=
# Header used when AUTH_TYPE=apikey
API_KEY_HEADER=x-api-key
# QuickPizza profile: any 16-character value (it identifies the test client;
# it is not a secret), e.g. QUICKPIZZA_TOKEN=<any-16-characters>
QUICKPIZZA_TOKEN=

# ------------------------------------------------------------- freshdesk ----
# TARGET_PROFILE=freshdesk: low-volume, READ-ONLY validation against a real
# Freshdesk account (npm run freshdesk:validate / freshdesk:smoke / freshdesk).
# NOT a capacity test. Domain root only (a pasted UI ://your-domain.freshdesk.compath is ignored).
FRESHDESK_BASE_URL=https
# Profile settings > View API key. Read only from the environment / this file;
# never logged, never written to results or reports. Never commit it.
FRESHDESK_API_KEY=
# Stop the run once >= this share of requests (whole run or any stage) is HTTP 429.
FRESHDESK_MAX_429_RATE=0.05
# true = enforce FRESHDESK_MAX_429_RATE; false = record 429s without stopping.
FRESHDESK_ABORT_ON_429=true
# Hard ceiling: profiles above this peak are refused before any request.
FRESHDESK_MAX_VUS=20
# VUs:hold pairs (same format as LOAD_STAGES). Default 1 -> 5 -> 10 -> 20 VUs.
# FRESHDESK_STAGES=1:30s,5:30s,10:30s,20:30s
# FRESHDESK_PAGE_SIZE=10

# --------------------------------------------------------------- workload ---
# Writes are disabled by default. The mock's cart endpoint is in-memory and
# bounded, so enabling it locally is safe. On staging, enable only after
# confirming the write path is sandboxed / idempotent.
ENABLE_WRITES=true
# Leave unset to use the active scenario's defaults (retail-mock shown).
# WEIGHTS=customer_search:40,product:20,inventory:20,order_status:15,cart_write:5
# THINK_TIME_MIN=0.5
# THINK_TIME_MAX=1.5
REQUEST_TIMEOUT=10s

# ------------------------------------------------------------ load profile --
# Defaults shown (uncomment to override). VUs:hold pairs; each stage ramps
# 0 -> VUs, holds, ramps down, cools down. Explicit values here override
# LOAD_PROFILE=quick.
# LOAD_STAGES=10:30s,20:30s,30:30s,50:60s,100:60s,150:60s,200:60s,300:60s,500:60s
# RAMP_UP=15s
# RAMP_DOWN=5s
# COOLDOWN=10s
# LOAD_PROFILE=quick   # ~3 min dry run of the whole pipeline

# STRESS_LEVELS=100,200,300,500,750,1000
# STRESS_STEP_RAMP=15s
# STRESS_STEP_HOLD=30s

# SMOKE_VUS=2
# SMOKE_DURATION=30s

# ------------------------------------------------------- example SLAs -------
# EXAMPLE values only. Replace with the customer's real business requirements.
SLA_P95_MS=1000
SLA_P99_MS=2000
SLA_ERROR_RATE=0.01
SLA_5XX_RATE=0.005
SLA_TIMEOUT_RATE=0.005
# 429s are reported separately (not app errors), but above this rate a stage is
# not considered within SLA: rate-limited customers were not served.
SLA_429_RATE=0.01
# CI gate: fail the run if SLA is missed at <= this many VUs (0 = off)
SLA_GATE_VUS=0

# ---------------------------------------------------------- safety valves ---
ABORT_ON_ERROR_RATE=0.5
ABORT_ON_429_RATE=0.1
STRESS_ABORT_ERROR_RATE=0.2

# ------------------------------------------------- local mock API settings --
# Only used by mock-api/server.js. Set MOCK_API_TOKEN (and API_TOKEN to the
# same value) to demonstrate authenticated testing.
MOCK_PORT=8080
MOCK_API_TOKEN=
MOCK_DB_POOL_SIZE=8
MOCK_DB_ACQUIRE_TIMEOUT_MS=1500
MOCK_INVENTORY_CONCURRENCY=5
MOCK_INVENTORY_LATENCY_MIN_MS=40
MOCK_INVENTORY_LATENCY_MAX_MS=90
MOCK_INVENTORY_ACQUIRE_TIMEOUT_MS=2000
# 0 disables the rate limiter. Try MOCK_RATE_LIMIT_RPS=300 to see 429 handling.
MOCK_RATE_LIMIT_RPS=0
